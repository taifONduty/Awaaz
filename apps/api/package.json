{
  "name": "@awaaz/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write src test scripts package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src test scripts package.json tsconfig.json .prettierrc.json",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "dev": "node --env-file-if-exists=.env src/index.ts",
    "test:db": "node --env-file-if-exists=.env.test --test --test-concurrency=1 test/integration/*.test.ts",
    "test:android-fixtures": "node --env-file=.env.test test/android-fixtures.ts",
    "openapi": "node scripts/export-openapi.ts",
    "evidence:worker": "node --env-file=.env.evidence scripts/run-evidence-worker.ts",
    "evidence:health": "node --env-file=.env.evidence scripts/check-evidence-worker.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "9.9.2",
    "@supabase/supabase-js": "^2.117.3",
    "fastify": "^5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  }
}
