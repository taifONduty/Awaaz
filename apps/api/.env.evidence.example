# Dedicated awaaz_evidence LOGIN role, NOINHERIT and no role memberships.
# Do not use postgres, service_role, awaaz_api or an Android Maps credential.
AWAAZ_EVIDENCE_DATABASE_URL=postgresql://awaaz_evidence:YOUR_PASSWORD@YOUR_DATABASE_HOST:5432/postgres
DATABASE_CA_CERT_PATH=
# Absolute paths; use the same artifact directory in the route API environment.
AWAAZ_ROUTING_MANIFEST=
AWAAZ_EVIDENCE_OUTPUT_DIR=
# Optional consistency check; the confirmed manifest supplies the graph version.
AWAAZ_EVIDENCE_GRAPH_VERSION=
# Use a unique absolute awaaz-evidence*.health.json file for each worker replica.
AWAAZ_EVIDENCE_HEALTH_FILE=
