# A fresh Supabase project. Never use the prototype's old credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Dedicated database role, not postgres or service_role. Use the pooler when needed.
# Remove all SSL URL parameters: remote TLS is verified by code.
DATABASE_URL=postgresql://awaaz_api:YOUR_PASSWORD@YOUR_DATABASE_HOST:5432/postgres
# Optional vendor CA bundle when your database requires one.
DATABASE_CA_CERT_PATH=
# Generate a random 32-byte secret as 64 hex characters. Server only.
INVITE_TOKEN_SECRET=
HOST=127.0.0.1
PORT=3030
LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:8765
# Optional geographic routing. Run prepare/start/confirm-routing.ps1 locally.
# No Android Google Maps credential is used by the server router.
AWAAZ_GRAPHHOPPER_URL=
AWAAZ_ROUTING_MANIFEST=
# Optional private Java worker; when set, it replaces the HTTP routing transport.
AWAAZ_ROUTING_JAVA=
# Experimental reviewed-evidence alternatives; keep disabled until evaluated.
AWAAZ_EXPERIMENTAL_EVIDENCE_ROUTING=false
# Optional shared private evidence-artifact directory; absolute path required.
AWAAZ_EVIDENCE_OUTPUT_DIR=
# Optional checksum-pinned offline public OSM place catalogue, absolute JSON path.
AWAAZ_PLACE_CATALOG_FILE=
